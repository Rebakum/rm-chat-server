# Database
DATABASE_URL=postgresql://user:password@localhost:5432/rahmah_institute

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Better Auth
BETTER_AUTH_SECRET=your_better_auth_secret_min_32_chars_long
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# Nodemailer (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Rahmah Institute <your_email@gmail.com>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxx
SUPABASE_BUCKET=rahmah-uploads
# SUPABASE_SERVICE_KEY and SUPABASE_KEY are also accepted as legacy alternatives.

# EPS Payment Gateway
EPS_MERCHANT_ID=xxx
EPS_SECRET_KEY=xxx
EPS_API_URL=https://eps.yourgateway.com
EPS_SUCCESS_URL=http://localhost:5000/api/eps/success
EPS_FAIL_URL=http://localhost:5000/api/eps/fail
EPS_CANCEL_URL=http://localhost:5000/api/eps/cancel

# OTP lifetime for signup verification (5-10 minutes)
OTP_TTL_MINUTES=10
