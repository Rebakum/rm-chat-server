{
  "name": "rahmah-institute-server",
  "version": "1.0.0",
  "description": "Rahmah Institute Backend — Islamic Education Marketplace",
  "main": "src/server.ts",
  "scripts": {
    "dev": "prisma generate --schema prisma/models && tsx watch src/server.ts",
    "start": "prisma generate --schema prisma/models && tsx src/server.ts",
    "build": "tsc",
    "start:prod": "node dist/server.js",
    "db:generate": "prisma generate --schema prisma/models",
    "db:push": "prisma db push --schema prisma/models",
    "db:migrate": "prisma migrate dev --schema prisma/models",
    "db:migrate:prod": "prisma migrate deploy --schema prisma/models",
    "seed:admin": "tsx prisma/seed-admin.ts",
    "check:teacher-options": "tsx scripts/check-teacher-options.ts",
    "db:studio": "prisma studio --schema prisma/models"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.2",
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.49.4",
    "better-auth": "^1.7.2",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.3",
    "react-icons": "^5.7.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^6.4.17",
    "nodemon": "^3.1.9",
    "prisma": "^6.19.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
