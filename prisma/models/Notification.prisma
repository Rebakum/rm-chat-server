model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String
  message    String
  actionData Json?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}
